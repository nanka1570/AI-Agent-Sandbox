{
  "name": "claude-code-like",
  "version": "0.1.0",
  "description": "Terminal-based AI pair programmer powered by Anthropic Claude",
  "type": "module",
  "bin": {
    "claude-code-like": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^1.44.0",
    "chalk": "^5.6.2",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^6.27.0",
    "ora": "^8.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
