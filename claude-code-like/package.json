{
  "name": "claude-code-like",
  "version": "0.1.0",
  "description": "Terminal-based AI pair programmer powered by Anthropic Claude",
  "type": "module",
  "bin": {
    "claude-code-like": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.4.1",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "ora": "^8.1.1",
    "fast-glob": "^3.3.3",
    "diff": "^7.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/diff": "^7.0.0"
  }
}
