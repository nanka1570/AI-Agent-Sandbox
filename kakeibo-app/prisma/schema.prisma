// Prisma スキーマ定義
// 家計簿アプリ（kakeibo-app）のデータモデル

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 給料
model Salary {
  id        String   @id @default(cuid())
  payDay    Int      // 支給日（1-31）
  amount    Int      // 手取り額（円）
  month     String   // 対象月 "2026-03"
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// クレジットカード
model CreditCard {
  id         String    @id @default(cuid())
  name       String    // カード名
  closingDay Int       // 締め日（1-31）
  paymentDay Int       // 支払い日（1-31）
  memo       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]
}

// 支払い
model Payment {
  id           String     @id @default(cuid())
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  month        String     // 対象月 "2026-03"
  amount       Int        // 確定金額（円）
  status       String     @default("unconfirmed") // unconfirmed | confirmed | paid
  memo         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
