// Prisma スキーマ定義
// 家計簿アプリ（kakeibo-app）のデータモデル

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 給料
model Salary {
  id        String   @id @default(cuid())
  userId    String   // Supabase Auth の user.id
  payDay    Int      // 支給日（1-31）
  amount    Int      // 手取り額（円）
  month     String   // 対象月 "2026-03"
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// クレジットカード
model CreditCard {
  id         String    @id @default(cuid())
  userId     String    // Supabase Auth の user.id
  name       String    // カード名
  closingDay         Int  // 締め日（1-31）
  paymentDay         Int  // 支払い日（1-31）
  paymentMonthOffset Int  @default(0) // 支払月オフセット（0=当月, 1=翌月, 2=翌々月）
  memo       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]

  @@index([userId])
}

// 支払い
model Payment {
  id               String     @id @default(cuid())
  userId           String     // Supabase Auth の user.id
  creditCardId     String
  creditCard       CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  month            String     // 対象月 "2026-03"
  amount           Int        // 確定金額（円）
  status           String     @default("unconfirmed") // unconfirmed | confirmed | paid
  memo             String?
  isRecurring      Boolean    @default(false)   // 毎月繰り返し支払いかどうか
  recurringGroupId String?    // 繰り返しグループID（同じグループの支払いに同じIDが付く）
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
}

// カテゴリ
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   // チャート表示用 "#FF6384"
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments  Payment[]
  budgets   Budget[]

  @@index([userId])
}

// 予算
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String   // "2026-03"
  amount     Int      // 予算額（円）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month])
  @@index([userId])
}
